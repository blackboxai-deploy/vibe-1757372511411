# Bot de Telegram Token - Obtener de @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Base de datos SQLite
DATABASE_PATH=./data/videos.db

# Configuración de almacenamiento
STORAGE_PATH=./data/videos
TEMP_PATH=./data/temp
THUMBNAILS_PATH=./data/thumbnails

# Configuración del bot
MAX_FILE_SIZE_MB=100
AUTO_START_BOT=true

# Chats permitidos y bloqueados (separados por comas)
# Ejemplo: ALLOWED_CHATS=-1001234567890,-1009876543210
ALLOWED_CHATS=
BLOCKED_CHATS=

# Configuración de la aplicación web
NEXTAUTH_SECRET=telegram_video_bot_secret_key_2024
NEXTAUTH_URL=http://localhost:3000

# Puerto de la aplicación
PORT=3000